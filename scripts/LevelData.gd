class_name LevelData
extends RefCounted
## 关卡数据：三层跑道（横版，每层一条道）。
##
## 每个 segment: { length: float, colors: [int,int,int], ...可选字段 }
##   colors[0..2] 是自下而上三层的颜色（A / B / X）
##
## 可选字段（2026-10-10 新增的三种机制，全部可选，缺省 = 无该机制）:
##   "boost": float       该段速度倍率（GameConfig.BOOST_MULT）
##   "pulse": true        该段三层同步在青/橙之间呼吸（周期 GameConfig.PULSE_PERIOD）
##   "crystals": [[layer, offset_m, value], ...]   段内能量晶体
##   "toll": true         该段是"收费口"——刻意的纯异色短段，别当门审
##                        （地形和"软门"一样，校验器只能靠这个标记区分意图）
##
## 横版重构带来的硬约束:
##   三层全同色只对一种颜色安全 —— 必须写成「至少一青一橙」的呼吸点，
##   否则会变成对另一半玩家的必死彩票。
##
## 关卡设计的硬约束（违反任何一条关卡就是坏的）:
##   1. 可通关性  —— 存在一条路径使能量全程 > 0（SelfTest 会验）
##   2. 多解性    —— 四种玩家原型（冲刺/保守/切色/连跳）里至少三型能通关，
##                  否则玩家是在背答案
##   3. 可读性    —— 任何颜色切换段不得短于【一次竖直动作能前进的最大距离】
##                  = SPEED_DASH × fall_air_time(2→0) = 24 × 0.7071 = **17.0m**
##                  【2026-10-10 四次定稿】下坠改自由落体后这条线从 13.9 抬到 17.0：
##                  掉两层的 0.7071s 比跳跃的 0.58s 还长，是现在最远的空中位移。
##                  校验器按这个值报警（见 SelfTest 的 min_legible）。
##   4. 不依赖    —— 可通关性不允许依赖晶体。校验器一律按"一颗没吃到"计算。
##                  晶体是纯收益，不是解法的组成部分，否则关卡退化成背路线。
##   5. 【2026-10-10 四次定稿新增】竖直可达性 —— 段与段之间【禁止跨两层衔接】。
##                  跳跃峰值只有 出发层+4.4m，够到 +1 层、够不到 +2 层，
##                  所以"下一段只有更高的层"= 死局。
##                  check_forward_escape 直接调引擎抓这个，抓到过 L2 段10。

var level_name := ""
var segments: Array = []
var target_time := 0.0    # 二星：通关且用时 ≤ 此值
var challenge_time := 0.0 # 三星：通关且用时 ≤ 此值

func _init(p_name := "", p_segments := [], p_target := 0.0, p_challenge := 0.0) -> void:
	level_name = p_name
	segments = p_segments
	target_time = p_target
	challenge_time = p_challenge

func total_length() -> float:
	var s := 0.0
	for seg in segments:
		s += float(seg["length"])
	return s

func segment_index_at(dist: float) -> int:
	var acc := 0.0
	for i in segments.size():
		if dist < acc + float(segments[i]["length"]):
			return i
		acc += float(segments[i]["length"])
	return segments.size() - 1

## 段起始距离（HUD 前方预警用）
func segment_start(i: int) -> float:
	var acc := 0.0
	for k in mini(i, segments.size()):
		acc += float(segments[k]["length"])
	return acc

func _color_of(seg: Dictionary, layer: int) -> int:
	var colors: Array = seg["colors"]
	return int(colors[clampi(layer, 0, colors.size() - 1)])

## 查询某层的颜色（不含脉冲的时间维度 —— 供校验器等静态用途）
func color_at(dist: float, layer: int) -> int:
	return _color_of(segments[segment_index_at(dist)], layer)

# ------------------------------------------------------------
# 新机制查询
# ------------------------------------------------------------
## 该位置的速度倍率。无加速带 → 1.0
func boost_at(dist: float) -> float:
	var seg: Dictionary = segments[segment_index_at(dist)]
	return float(seg.get("boost", 1.0))

## 该位置是否处于脉冲段
func is_pulse(dist: float) -> bool:
	var seg: Dictionary = segments[segment_index_at(dist)]
	return bool(seg.get("pulse", false))

## 脉冲相位：true = 已翻转（当前显示的是颜色的"反面"）
## 翻转节奏 = 每 PULSE_PERIOD/2 秒翻一次，与校验器的最坏情况假设一致。
func pulse_flipped(t: float) -> bool:
	var half := GameConfig.PULSE_PERIOD * 0.5
	return int(floor(t / half)) % 2 == 1

## 带时间的颜色查询。脉冲段会随时间翻转 —— 这是玩家在游戏中看到的值。
func color_at_t(dist: float, layer: int, t: float) -> int:
	var seg: Dictionary = segments[segment_index_at(dist)]
	var c := _color_of(seg, layer)
	if c == GameConfig.NO_TRACK:
		return c
	if bool(seg.get("pulse", false)) and pulse_flipped(t):
		c = 1 - c
	return c

## 该位置有哪些层是有跑道的（自下而上的层号数组）。
## 留空改造后这是最高频的查询：玩家随时要知道"我能站哪儿"。
func track_layers_at(dist: float) -> Array:
	var seg: Dictionary = segments[segment_index_at(dist)]
	var out: Array = []
	var colors: Array = seg["colors"]
	for i in colors.size():
		if int(colors[i]) != GameConfig.NO_TRACK:
			out.append(i)
	return out

## 该段是否存在同色层（对给定玩家颜色）。不存在 = 这是一道"门"。
## 静态版本：脉冲段按最坏情况（翻转后）判断，宁可悲观。
func has_same_color(seg: Dictionary, pcolor: int) -> bool:
	var colors: Array = seg["colors"]
	for c in colors:
		var cc := int(c)
		if cc == pcolor:
			return true
		# 脉冲段会翻转到反面，所以"当前是异色"不代表一直异色 —— 反之亦然。
		# 这里为了不误判成"有同色层"，只有在【翻转后】仍为同色才算安全。
	return false

## 展平所有晶体到绝对距离（{dist, layer, value}）
## 运行时由 Player 消费；校验器刻意不消费（见类注释硬约束 4）。
func crystal_list() -> Array:
	var out: Array = []
	for i in segments.size():
		var seg: Dictionary = segments[i]
		if not seg.has("crystals"):
			continue
		var start := segment_start(i)
		for c in seg["crystals"]:
			out.append({
				"dist": start + float(c[1]),
				"layer": int(c[0]),
				"value": float(c[2]) if c.size() > 2 else GameConfig.CRYSTAL_VALUE,
			})
	return out

## 前方扫描：从 dist 起找下一道门，返回 {dist, len, kind} 或 null。
##
## Rationale: 110m 切色门和 78m 冲刺门的最优解完全相反（一个必须切色、
##   一个必须冲刺），而玩家在画面里只看得见颜色、看不见长度。读不出长度，
##   L3 的核心战略决策就退化成瞎猜。这条预警是 Pillar「风险必须可读」的
##   硬要求，不是锦上添花。
func next_gate(dist: float, pcolor: int) -> Variant:
	for i in segments.size():
		var start := segment_start(i)
		var L := float(segments[i]["length"])
		if start + L <= dist:
			continue
		# 脉冲段不是门 —— 它有自己的预警通道。混进门预警里会给出错误的建议
		# （"按 J 切色"对脉冲段完全没用，切了色相位照样翻）。
		if bool(segments[i].get("pulse", false)):
			continue
		if has_same_color(segments[i], pcolor):
			continue
		var kind := "切色门" if L > GameConfig.DEATH_ZONE_MAX_LEN else "冲刺门"
		return {
			"dist": start - dist,
			"len": L,
			"kind": kind,
			"index": i,
		}
	return null

## 前方扫描：找下一处指定机制（"pulse" / "boost"），返回 {dist, len, index} 或 null。
func next_feature(dist: float, want: String) -> Variant:
	for i in segments.size():
		var start := segment_start(i)
		var L := float(segments[i]["length"])
		if start + L <= dist:
			continue
		var seg: Dictionary = segments[i]
		var hit := false
		if want == "pulse":
			hit = bool(seg.get("pulse", false))
		elif want == "boost":
			hit = float(seg.get("boost", 1.0)) > 1.0
		if hit:
			return {"dist": start - dist, "len": L, "index": i}
	return null

## 前方扫描：从 dist 起找下一个"本层跑道中断"的段。
## Rationale: 缺口掉下去要付 8 点（且可能落在异色上）。没有预警的情况下，
##   缺口会变成"看不清就罚"，这是设计事故不是难度。90m 内给出预警，
##   玩家才有时间选"跳去哪层"。
func next_gap(dist: float, layer: int) -> Variant:
	for i in segments.size():
		var start := segment_start(i)
		var L := float(segments[i]["length"])
		if start + L <= dist:
			continue
		if _color_of(segments[i], layer) != GameConfig.NO_TRACK:
			continue
		return {"dist": start - dist, "len": L, "index": i}
	return null

# ------------------------------------------------------------
# 关卡库
# ------------------------------------------------------------
## 注意: 这里刻意用字面量 0/1 而不是 GameConfig.LaneColor.A/B。
## autoload 节点在脚本常量初始化阶段尚未就绪，直接引用会得到 null。
const A := 0        # 青
const B := 1        # 橙
const X := -1       # 缺口：该层此段没有跑道（GameConfig.NO_TRACK）

## ============================================================
## 【2026-10-10 第三次重构：按"单纯跳跃 + 自然下落"重排全三关】
## ============================================================
## 前两轮重构的语言（"空层自动跳过""跨空层跳跃""上跳 2 层"）在四次定稿之后
## 【全部失效】。这一版先把新机制的**可达集合**推出来，再按它排版 ——
## 因为 L2 段10 那个死局就是"沿用旧语言排版"的直接产物。
##
## ── 一次竖直动作能到哪里（全局唯一的竖直规则）──
##   规则：一次动作有一个【峰值高度】；落点 = 峰值之下最高的那块实体跑道。
##   W 跳：峰值 = 出发层 + 4.4m（顶层被夹在 7.6m）
##   S 落 / 踩空：峰值 = 出发层（不上升），自由落体
##
##   站在层 p（脚下有跑道）时，一次动作的落点只可能是这三种：
##     ① p + 1   —— 且【仅当】p+1 在那次动作的落点距离上有跑道   （W）
##     ② p       —— p+1 是缺口，而 p 本身有跑道（W 原地弹 / 原地不动）（W 或不动）
##     ③ 【p 之下最高的那条】 —— 由几何算定，玩家【不能挑】 （S / 踩空）
##
##   ⚠ 由此推出一条会直接毁掉关卡的禁令：
##     【N → N+2 的段间衔接不存在】。跳跃只够到 +1 层。
##     想把玩家送到 +2 层，必须给他一个中间站（一段在 p+1 有跑道）。
##     校验器 check_forward_escape 直接调引擎抓这个 —— 它是这条禁令的探测器。
##
##   ⚠ 第二条容易忽略的：**向下只能落到"最高的那条"**。
##     所以"从层2 掉到层0"要求层1 是空的；层1 有跑道就一定停在层1。
##     想让玩家下两层，中间那层【必须】留空 —— 这不是风格选择，是语法。
##
## ── 留空带来的设计纪律（违反会做出坏关）──
##   A. 【门必须建在玩家已经站着的层上】
##      冲刺要满能量（ENERGY_MAX 才 arm），而任何一次跳跃都扣 8 点 ——
##      所以"跳一下才够得着"的门永远不可能被冲刺通过。
##      门的跑道层 = 上一段结束时玩家所在的层，这条必须对齐。
##      切色门不受这条约束（切色本来就把能量清零，跳不跳无所谓），
##      但切色门前的段要**故意攒不满**，否则玩家会优先冲刺而不是切色。
##   B. 【脉冲段必须有两层】
##      单层跑道上玩家无处可跳，"跳起来冻结结算"这条唯一的应对手段失效 ——
##      脉冲段会退化成纯挨打。两层可以来回横跳。
##   C. 【冲刺门前必须有一段足够长的同色补满段】
##      门建在玩家所在层只是必要条件，能量还得真的够 —— 冲刺门要求【满】，
##      不是"够付"。所需长度 = 1.5 × (100 − 进门时的能量) m
##      （同色 +8/s、常速 12 m/s → 1.5m 换 1 点）。
##      扣掉段内换层动作的滞空（跳跃 6.96m / 掉两层 8.49m 不结算）。
##   D. 【任何段长 ≥ 17.0m】—— 见文件头硬约束 3。
##
## ── 词汇表 v3（可用地形）──
##   1. 【独木桥】  [-1, A, -1]        强制路线 + 强制颜色。门与长段的标准载体。
##   2. 【上跳梯】  连续两段 [-1,A,-1] → [-1,-1,A]
##                                     逐级 +1。**每级必须单独一段**，不能合并。
##   3. 【自由落体】[A, -1, -1] 接在玩家位于层2 时
##                                     一次穿过空的层1 落到层0（0.71s，最慢的坠落）。
##   4. 【双层站】  [A, A, -1]        第一次"随便站"；也是"给下一步留选择"的缓冲。
##                                     玩家可能停在任意一层 → 下一段必须对两层都可解。
##   5. 【逼迁】    [A, -1, B]        本层断、中间空 → 落点是几何算定的那一层，两难。
##   6. 【收费口】  [A, -1, A] + toll:true
##                                     对手色玩家三层里无处可躲，只能硬吃。
##                                     **必须带 toll 标记**：不带的话校验器会把它
##                                     当成"太短的门"报警（两者地形一模一样）。
##   7. 【分层解法】[A, -1, A] 且玩家在层1
##                                     同一段对层1 与层2 玩家是两道不同的题：
##                                     层1 玩家可 W 上到层2、也可掉到层0（有选择）；
##                                     层2 玩家只能掉到层0（无选择）。新机制独有。
##   8. 【断头台】  [-1, A, -1] 长段  冲刺门／切色门载体。
##   9. 【加速带】  boost 字段          异色段上是"省钱工具"（0.83 点/米 vs 硬闯 1.5）。

# ============================================================
# L1「霓虹初醒」—— 教学关
# ============================================================
## 教学顺序刻意编排，每个新动作单独引入后都有安全段消化：
##   S0 贴地起步 → S1 上跳一层 → S2 再上跳一层 → S3 自由落体掉两层
##   → S4 双层站 → S5 加速带 → S6 冲刺门 → S8 切色门 → S9 脉冲段
##
## 【玩家层必须一路对齐】本关每个门都建在玩家"上一段结束时已经站着的层"上：
##   S5 结束时在层1 → S6 的门也在层1（橙），玩家不需要跳就能冲刺。
##   如果门在别的层，"跳过去"本身要花 8 点，满能量被打破，冲刺就永远解锁不了。
##   这是留空改造后最容易犯的错，标记在此。
##
## S7 故意只给 85m：冲刺后剩 28 点，跑完 85m 只到 84.7 点 —— 差 15 点不到满，
## 冲刺解锁不了。于是 S8 的 78m 门只剩"切色"一条路。
## 这是把「切色」教出来的唯一办法：教学关必须让玩家被迫用一次，否则学不会。
##
## 【第三次重构改了什么】S3 的教学口径换了：旧版教的是"跳跃会跳过没跑道的层"
##   （这条规则已经不存在了）。现在它教的是**自然下落**：层1 是空的，
##   所以从层2 掉下去会一路穿到底层 —— 而且这是全关唯一一次【掉两层】，
##   0.71s 明显比掉一层（0.50s）长。玩家在这一段学到"落差越大掉得越久"。
##   它是本关唯一不可替换的段落：另外两关都会复用同一段地形，但只有这里
##   紧跟在上跳教学之后，玩家手里刚有"层"这个概念。
static func level_1() -> LevelData:
	return LevelData.new("L1 霓虹初醒", [
		# 贴地起步：只有底层有跑道。玩家立刻知道"跑道不是到处都是"。
		{"length": 72.0,  "colors": [A, -1, -1]},
		{"length": 48.0,  "colors": [-1, A, -1]},          # 只有中层青 → 教 W 上跳一层
		{"length": 40.0,  "colors": [-1, -1, A]},          # 只有顶层青 → 再上一层
		# 自由落体教学：层1 是空的，玩家在层2 → 一次坠落直接穿到底层，
		# 且这是全关唯一一次掉两层（0.71s）。玩家学到"落差越大掉得越久"。
		{"length": 45.0,  "colors": [A, -1, -1]},
		{"length": 48.0,  "colors": [A, A, -1]},           # 双层青：第一次"随便站"
		# 加速带教学：放在同色独木桥上，纯爽感，不引入风险。
		# 教学关的新机制必须"第一次遇到就是好事"，风险留到 L2 再上。
		{"length": 35.0,  "colors": [-1, A, -1], "boost": GameConfig.BOOST_MULT},
		# 冲刺门：同一条中层，颜色翻成橙。玩家不需要跳 —— 原地就变成了异色，
		# 这正是"冲刺"要解决的场面。硬闯 72×1.5 = 108 点必死。
		{"length": 72.0,  "colors": [-1, B, -1]},
		{"length": 85.0,  "colors": [-1, A, -1]},          # 只攒到 84.7 点 → 冲刺解锁不了
		# 切色门：门在顶层，玩家必须先上跳一层（-8）再切色。这一跳是刻意的 ——
		# 它顺手示范了"切色前先跳"（空中豁免）这条战术。
		# 注意这里【只上跳一层】是必须的：层1 → 层2 恰好是跳跃的上限，
		# 旧版从层0 直达层2 的设计在新规则下已经做不到了。
		{"length": 78.0,  "colors": [-1, -1, B]},
		# 脉冲段教学：两层交替。基础色里层1是橙（切色后玩家正是橙）→ 第一眼安全，
		# 然后开始呼吸：翻过来时层1变青(危险)、层2变橙(安全)，玩家要横跳。
		# 基础色选同色而不是异色，是刻意的：威胁必须自己长出来，不能一上来就罚。
		{"length": 26.0,  "colors": [-1, B, A], "pulse": true},
		{"length": 68.0,  "colors": [-1, B, -1]},          # 终点缓冲：落回中层同色
	# 本关最优 47.4s（纸面 47.38 / 实机 47.1）→ 二星 47.4×1.12=53.1→53，三星 ×1.04=49.3→49。
	#   本关没有脉冲段，纸面与实机本来就吻合（差 0.28s），所以旧值 53/49 一直是对的。
	], 53.0, 49.0)   # 二星=最优×1.12  三星=×1.04（数值见 SelfTest 输出）

# ============================================================
# L2「脉冲回廊」—— 频率关
# ============================================================
## 压力来自"切层频率"而不是门的长度。38-40m 的连续切层是刻意的：
##   38m = 3.17s，刚好够跳一次 + 站稳 + 读下一段；短于 30m 会变成手速游戏。
##
## 本关的核心是「加速带踩在异色上」这个反转用法：
##   加速带在异色上 = 0.83 点/米（比常速 1.5 便宜一半），是硬闯异色的唯一划算手段。
##   L1 教的是"加速带=爽"，L2 教的是"加速带=工具"，同一机制的第二层理解。
##   独木桥在这里帮了大忙：只有一条道时玩家无处可跳，"硬吃下来"是唯一选项，
##   于是加速带省了多少点变成一道很干净的心算题。
##
## ⚠【段10→段11 的死局：已修，记在这里防止下次又踩】
##   旧版 S10 = [A,A,-1]（层0/层1）、S11 = [-1,-1,A]（只有层2），
##   设计意图是"从层0 一次上跳直达层2"——那是【上一代跳跃规则】的产物。
##   四次定稿后跳跃峰值只有 出发层+4.4，够到 +1 层、够不到 +2 层，
##   于是"站在层0 的玩家"在段末尾无路可走（下一段只有层2）→ 死局。
##
##   修法不是简单删掉它，而是把"上升"拆成两次 +1，并保证玩家一定在中间层：
##     S9  脉冲（层1/层2）→ 玩家必定在层1 或层2，**这是修法的前提**
##     S10 双层青（层1/层2）→ 不需要动作，顺便当补满段       ✔
##     S11 只有层2        → 从层1 上跳一次，只 +1 层          ✔
##   关键是【先保证玩家站在中间层，再让他往上】。旧版让玩家停在层0 还看得见层2，
##   就是坏在这里。这条纪律现在写进了 SelfTest.check_forward_escape，它直接调引擎抓。
static func level_2() -> LevelData:
	return LevelData.new("L2 脉冲回廊", [
		{"length": 45.0,  "colors": [A, -1, -1]},
		{"length": 40.0,  "colors": [-1, A, -1]},          # W 上跳 → 层1
		{"length": 40.0,  "colors": [-1, -1, A]},          # W 上跳 → 层2
		# 自由落体掉两层：层1 空，所以从层2 一次落到层0（0.71s）。
		# 与 L1 段3 同一地形 —— 那里是第一次见，这里是"你已经会了"。
		{"length": 38.0,  "colors": [A, -1, -1]},
		{"length": 36.0,  "colors": [-1, A, -1], "boost": GameConfig.BOOST_MULT},
		# 加速带 + 异色：本关第一处"把加速带当工具"的地方。
		# 30m 异色常速要 45 点，踩加速带只要 25 点 —— 省了将近一半。
		# 独木桥保证玩家无处可躲，这个对比才成立。
		{"length": 30.0,  "colors": [-1, B, -1], "boost": GameConfig.BOOST_MULT},
		# 52m 不是随手加的。这是本关的第一段【补满段】，长度由纪律 C 反推：
		#   段5 之后"冲刺流"剩 70 点（它在段5 用了冲刺），保守流剩 75 点。
		#   原来写 42m → 冲刺流只到 98 点，**差 2 点不到满** → 段7 的冲刺按不出来，
		#   于是"冲刺流"被迫切色，反而比"保守流"慢 6 秒（SelfTest 抓到过）。
		#   一条名叫冲刺门的门，最想冲刺的那型玩家却冲不了 —— 这是名不副实。
		#   52m 给 34.7 点，70 + 34.7 = 104.7 → 封顶 100，留 5 点余量。
		{"length": 52.0,  "colors": [-1, A, -1]},          # 补满段 + 立刻回血
		{"length": 72.0,  "colors": [-1, B, -1]},          # 冲刺门 #1（同一条中层）
		# 90m 同理：它是第二段【补满段】，为段12 的冲刺门服务。
		#   段7 冲刺后剩 28 点，段8 90m 给 60 点 → 88 点，
		#   熬过段9 脉冲（最坏 -29）还有 59，段10+段11 共 96m 足够推到满。
		#   原来写 80m 时，段12 的 85m 门只剩 76 点 → 冲刺按不出来 → 又变成切色门。
		{"length": 90.0,  "colors": [-1, A, -1]},
		# 脉冲段：两层交替。基础色层1 = 同色，第一眼安全。
		{"length": 26.0,  "colors": [-1, A, B], "pulse": true},
		# ── 上升梯（修正版）：把旧的"一次上两层"拆成 +1 两连 ──
		# 顺序很重要：先给一段【不需要动作】的双层青当缓冲与补满段，
		#   再让玩家做那一次 +1 的上跳。反过来的话，玩家会刚出脉冲段
		#   就被逼着做一个"跳不过去就摔死"的动作 —— 那是把两个难点叠在一起。
		{"length": 56.0,  "colors": [-1, A, A]},           # 双层青：缓冲 + 补满段
		{"length": 40.0,  "colors": [-1, -1, A]},          # W 上跳 → 层2（层0/层1 都空）
		# 冲刺门 #2：双层橙，玩家已经在层2，无需起跳 → 满能量可以冲刺。
		# 56m 的双层青不是随手写的：它是本关的【补满段】，
		#   长度按"脉冲段最坏残血 + 一次上跳的滞空损耗"反推（见文件头纪律 C），
		#   短了就会出现"能量差一点点、冲刺按不出来"—— 那是最难查的一类设计错。
		{"length": 85.0,  "colors": [-1, B, B]},
		# 二选一 + 晶体：同色在层0，顶层是异色。晶体刻意放在【同色层】上 ——
		# 这一颗是"走对路线的奖励"，与后面 L3 那颗"走错路线的陷阱"形成对照。
		# 注意这一段的"下坠"落点是几何算定的：层1 空 → 从层2 直接落到层0。
		{"length": 40.0,  "colors": [A, -1, B],
			"crystals": [[0, 22.0, GameConfig.CRYSTAL_VALUE]]},
		# 终点缓冲【必须对两色友好】—— 与 L3 收尾段同一条纪律。
		#   旧版写 [A,-1,-1]（只有层0 青）：对橙玩家是 36m 纯异色、硬吃 54 点。
		#   一个名叫"缓冲"的段却在最后 54m 继续收费 —— 名不副实，而且玩得稍差的
		#   橙玩家会【死在终点线前】，那是最恼人的一种死法。
		#   改成双层后：青玩家在层0 不动（同色）；橙玩家从层2 掉到层1（橙，同色），
		#   一次 0.5s 的坠落正好落在安全层上 —— 这才是"缓冲"该有的样子。
		{"length": 36.0,  "colors": [A, B, -1]},           # 终点缓冲（两色各有安全层）
	# 【星级线重标（第四次定稿后）】本关最优 51.6s（纸面 51.63 / 实机 51.3，差 <0.7%）。
	#   二星 = 51.6×1.12 = 57.8 → 58；三星 = 51.6×1.04 = 53.7 → 54。
	#   旧值 59/55 是按【重构前】的 50.10s 派的，全长改了 698→726m 之后就不准了。
	#   校验含义：58 把"不用冲刺"那一型（实机 58.1s）挡在二星外 —— 想拿二星必须
	#   用上冲刺，这正是星级该起的作用；而它离 58.1 只差 0.1s 是巧合，不是设计点。
	], 58.0, 54.0)   # 二星=最优×1.12  三星=×1.04（数值见 SelfTest 输出）

# ============================================================
# L3「双色回廊」—— 战略关（压轴）
# ============================================================
## 设计核心 —— 把"切色"从应急按钮升级为「区域通行证」。
## 前两关里切色永远是被逼的（没能量冲刺才切），玩家学不到它的战略价值。
## 这一关把跑道切成青区 / 橙区：进橙区前主动切色 = 归零，但整段橙色从此
## 变成回血区。风险与收益第一次同时成立，这是本关的可玩性来源。
##
## 节奏结构：「起（青区热身）— 承（冲刺门）— 转（切色进橙区）— 合（脉冲终局）」
## 三道门 + 两段脉冲，全都建在"玩家已经站着的层"上：
##   S4  68m   冲刺门   层1 独木桥，硬闯 102 点必死（玩家在层1，无需起跳）
##   S6  110m  切色门   层2 独木桥，冲刺上限 100m 够不到；切色后回血 73 点
##                       —— "必死走廊"反转成补给站，本关的高光时刻
##   S12 85m   冲刺门   层1 独木桥，对橙玩家全异色，本关唯一必须"攒满再放"的地方
##
## 终局刻意用【脉冲段】收尾而不是第四道门：
##   门是"读长度做决策"，脉冲是"读相位做操作"，两者是不同性质的考验。
##   压轴用操作收尾，玩家离手时记住的是"我掐准了那一拍"，而不是"我算对了数字"。
##
## 本关用到「收费口」[A, -1, A] 一次（S8）：
##   三层里没有橙（橙玩家无处安全），中间还空着（躲不掉）——
##   只能硬吃一段异色。比"底层断了逼你上跳"更狠，因为连上跳的选项都没有。
##
## 【第三次重构改了什么】
##   · 开场 S2 的"再上跳"原来是层1→层2 ✔ 两条 +1 台阶，现在依然合法
##     （旧版注释担心过它，其实它一直是分开的两段，不是一次跨两层）。
##   · **S11 补满段 100 → 115m**：这是校验器点名的一处真实缺陷。
##     原注释按"脉冲后残血 35 点"推算 100m，但校验器算出的最坏残血是 27.6 点，
##     要 109m 才够把冲刺重新 arm 起来。于是纸面最坏情况下段12 的 85m 冲刺门打不开
##     （SelfTest 的冲刺流在那里被迫转了切色）。实机没事（bot 入场就 68 点），
##     但"纸面最坏情况下打不开"就是一个必须修的缺陷 —— 校验器不许撒谎。
##     115m 给 76.7 点，27.6 + 76.7 = 104.3 → 封顶 100，留有 5m 余量。
static func level_3() -> LevelData:
	return LevelData.new("L3 双色回廊", [
		# ── 起：青区热手 + 切层节奏（两条 +1 台阶，再一条只降一层）──
		{"length": 28.0,  "colors": [A, -1, -1]},
		{"length": 28.0,  "colors": [-1, A, -1]},          # W 上跳 → 层1
		{"length": 28.0,  "colors": [-1, -1, A]},          # W 上跳 → 层2
		# 与 L1/L2 的"掉两层"刻意对照：这里层1 有跑道，所以一次下坠只降一层。
		# 玩家在这里确认自己学会了新规则 —— "下坠落到最高的那条，不是底那条"。
		{"length": 28.0,  "colors": [-1, A, -1]},
		# ── 承：第一道门。玩家在层1，满能量，是"冲刺最爽"的一次示范 ──
		{"length": 68.0,  "colors": [-1, B, -1]},          # 冲刺门 #1
		# 切色决策窗口。晶体刻意放在【异色层】：这一颗是"走错路线的陷阱"，
		# 与 L2 那颗"走对路线的奖励"形成对照 —— 玩家要学会辨认两者。
		{"length": 30.0,  "colors": [-1, B, A],
			"crystals": [[1, 16.0, GameConfig.CRYSTAL_VALUE]]},
		# ── 转：高光时刻。对青玩家全异色 110m —— 冲刺够不到，硬闯必死，
		#    唯一解是切色。而切色之后这 110m 全部变成回血区，回 73 点。
		#    玩家人数上必须在层2（段5 有两层，段6 只有层2 —— 一次 +1 上跳即可）。
		{"length": 110.0, "colors": [-1, -1, B]},          # 切色门 → 转橙（玩家已在层2）
		# ── 合：橙区。玩家已是橙色，以下全按"橙=同色"读 ──
		{"length": 26.0,  "colors": [-1, -1, B]},          # 橙区回血
		# 收费口 26m：三层里没有橙，中间还是空的 —— 橙玩家无处安全也躲不掉，
		# 只能硬吃 26 × 1.5 = 39 点。这是本关"看得到回血却拿不到"的时刻。
		# ⚠ 按 S 掉到层0 也是青（同样异色）→ 白花 8 点。正确打法是【不动】。
		# "toll" 标记 = 告诉校验器【这是刻意的收费口，不是门】。
		#   它和"软门"【地形完全相同】（纯异色段），校验器没法从地形区分两者，
		#   于是会对它报"硬闯只需 39 点，冲刺失去意义" —— 那是误报。
		#   作者的意图必须进数据，否则以后读到那条警告的人会以为关卡有缺陷。
		#   （校验器撒谎和漏报一样有害：它会让真警告淹没在假警告里。）
		{"length": 26.0,  "colors": [A, -1, A], "toll": true},
		{"length": 26.0,  "colors": [-1, B, -1]},          # 落回中层橙 → 回血
		# 脉冲段 #1：两层交替（层1 橙 / 层2 青）。基础色层1 = 同色，第一眼安全。
		{"length": 26.0,  "colors": [-1, B, A], "pulse": true},
		# 补满段：必须足够长，把玩家从"脉冲后的残血"推到满能量。
		# 115m 的来历（2026-10-10 第三次重构修正）：脉冲最坏情况后残血 27.6 点，
		#   补满需 72.4 点 = 9.05s = 108.6m；取 115m 留 5m 余量。
		# 【这是留空改造后最容易错的一处】门建在玩家所在层只是必要条件，
		#   能量还得真的够 —— 冲刺门要求【满能量】，不是"够付"。
		{"length": 115.0, "colors": [-1, B, -1]},
		# 冲刺门 #2：中层独木桥，对橙玩家全异色 85m（硬闯 128 必死）。
		# 玩家一路都在层1，无需起跳 → 满能量可以直接冲刺。
		{"length": 85.0,  "colors": [-1, A, -1]},
		# 冲刺后只剩 15 点，下面三段都写成【一青一橙】的双层：
		# 两条路线（冲刺成功=橙 / 被迫切色=青）都能找到自己的安全层。
		# 收尾段必须对两种颜色都友好，否则整关会被一条支线的死局否掉。
		{"length": 40.0,  "colors": [-1, B, A]},
		{"length": 26.0,  "colors": [A, B, -1], "pulse": true},   # 终局脉冲
		{"length": 32.0,  "colors": [A, B, -1]},           # 终点缓冲
	# 【星级线重标（第四次定稿后）】本关最优 53.8s（纸面 53.79 / 实机 53.8，几乎相等）。
	#   二星 = 53.8×1.12 = 60.3 → 60；三星 = 53.8×1.04 = 55.9 → 56。
	#   旧值 63/58 是按重构前的 55.37s 派的 —— 那次纸面把脉冲段按"整段都站在异色上"
	#   估最坏情况，比实机慢 5~7%，星级线跟着被撑松，实际倍率变成 ≈×1.18。
	#   本轮重排之后纸面与实机重合，那个偏差的根就没了，倍率回到设计值。
	], 60.0, 56.0)   # 二星=最优×1.12  三星=×1.04（数值见 SelfTest 输出）

static func all_levels() -> Array:
	return [level_1(), level_2(), level_3()]
