const FALL_ENERGY_COST := 8.0

## ═══ 下坠 = 自由落体（2026-10-10 四次定稿）═══
##
## 【用户要求】"同样调整跳到下一层的逻辑，变成自然下落"。
##   三次定稿把【跳跃】从"指定目标层"改成了"只决定峰值高度，落点由几何撞出来"。
##   这一版对【下坠】做同一件事 —— 下坠也【不指定落点，也不指定时长】：
##   它就是自由落体，时长由落差自己长出来。
##
## 【旧版的病：FALL_AIR_TIME = 0.5 是个常量，两处都错】
##   ① 观感错：掉 1 层（3.2m）用 0.5s，掉 2 层（6.4m）【也用】0.5s ——
##      后者的观感重力只有前者的一半。玩家看到的不是"掉得更远所以掉得更久"，
##      而是"两层楼之间的落差被凭空压缩了"。这不是物理，是补间。
##   ② 结构错：一个纯物理量（掉多久）被一个玩法常量钉住了。
##      于是"我想让跳跃手感变长"这件事会顺带改掉下坠的落点，
##      而"我想让下坠更狠"又会顺带改掉跳跃的射程 —— 上一版注释还在为
##      解耦这两者辩护，正确做法是让下坠【根本没有那个参数】。
##
## 【新规则】时长是【结果】不是【参数】：t = √(2h/g)，h = 落差。
##   掉 1 层 0.50s ／ 掉 2 层 0.71s —— 落差越大掉得越久，这才读得出重力。
##   落点解析因此必须【逐层】算时间：第 l 层的穿越时刻 = √(2·(出发层−l)/g)，
##   而不是所有层共用一个时长。见 Player._resolve_landing 的 time_for 回调。
##
## 【标定：唯一的自由参数 = 掉一层用半秒】
##   刻意沿用旧 FALL_AIR_TIME 的 0.50 → 最常见的那一次坠落（掉一层）逐帧不变，
##   已经验证过的落点、能量结算、HUD 节奏全部保持原样；
##   变的只有"掉两层更慢"这一件事。
##   g = 2·LAYER_SPACING / 0.50² = 25.6 m/s²
##   写成表达式而不是硬编码 25.6：将来改 LAYER_SPACING 时，
##   "掉一层仍然半秒"这个手感锚点会自动跟着走。
##
## [TUNING LEVER] 想整体改下坠节奏 → 只调 FALL_ONE_LAYER_SEC，别去动 FALL_GRAVITY。
##   0.4s 更利落（但 8 点的惩罚感会变弱）、0.7s 更沉（但会拖慢关卡节拍）。
##   注意它会同时改掉"缺口里飞多远"，所以改完必须重跑三套校验。
const FALL_ONE_LAYER_SEC := 0.5
const FALL_GRAVITY := 2.0 * LAYER_SPACING / (FALL_ONE_LAYER_SEC * FALL_ONE_LAYER_SEC)

## 从 [from_layer] 自由落体到 [to_layer] 需要多久（秒）。
##
## 这是下坠唯一的"时长来源" —— 旧版那个 `FALL_AIR_TIME` 常量已经删掉，
##   因为一个常量无法同时描述"掉一层"和"掉两层"。凡是需要下坠时长的
##   地方（request_jump / _check_track_gap / next_track_layer / SelfTest）
##   一律调它，别在本地重算 √(2h/g) —— 复刻一份物理 = 制造假阳性。
func fall_air_time(from_layer: int, to_layer: int) -> float:
	var h: float = LAYER_Y[from_layer] - LAYER_Y[to_layer]
	if h <= 0.0:
		return 0.0          # 没在往下掉（含同层）→ 不是下落
	return sqrt(2.0 * h / FALL_GRAVITY)

## 坠落时身体的纵向拉伸峰值（体积守恒 → 同时横向收窄到 1/√1.38 = 0.85）。
##
## 【2026-10-10 补 · 用户要求"下落要有下落的表现"】
##   上一版只把【瞬移】换成了 t² 轨迹，那是"表现"的一半：
##   轨迹只改变【位置怎么变】，不改变【身体长什么样】。
##   0.5s 的下落里角色是一具不变的胶囊被搬下去 —— 玩家读到的是
##   "摄像机带着我往下走"，而不是"我在往下掉"。
##   真正让人读出"下坠"的是【剪影】：越快越长。所以这里按速度给拉伸。
##
## 为什么是【随 t 线性】而不是常量：
##   t² 轨迹的瞬时速度 ∝ 2t，所以 t=0 时速度≈0、t=1 时最快。
##   常量拉伸会在起坠当帧就把身体拉长，与"刚从静止开始掉"矛盾 ——
##   那是"被拽下去"不是"掉下去"。线性拉伸在下落全程里持续变大，
##   视觉上就是"越来越快地往下掉"，与轨迹同源。
##   实现见 Player._update_transform 的 airborne and falling 分支。
##
## 为什么取 1.38：
##   ① 落地压扁是 0.60（坠落）—— 1.38 → 0.60 的落差给出冲击感，
##      拉伸太小（如 1.15）落地时读不出"砸"。
##   ② 上界受 clampf(_squash, 0.55, 1.5) 约束，且横向 0.85 时
##      角色仍明显是"立着的一条"而不是"一根针"。
##   ③ 与起跳拉伸 1.32 刻意错开：上跳/坠落两种剪影必须不同，
##      否则玩家分不清"我在跳"还是"我在掉"。
##
## ⚠ 这是【表现层常量】，不参与任何成本/可通关性计算 ——
##   校验器与 LogicTest 的物理断言都不读它。改它不影响平衡。
const FALL_STRETCH := 1.38

