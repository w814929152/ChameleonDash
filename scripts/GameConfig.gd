extends Node
## ============================================================
## ChameleonDash - Tuning 中心（唯一真理来源）
##
## 纪律：
##   1. 任何 magic number 不允许出现在其它脚本里，必须住在这里。
##   2. 每个数值必须带 rationale（为什么是这个数，不是别的数）。
##   3. 未经 playtest 验证的数值标 [PLACEHOLDER] 并附验证路径。
##
## 改数值只改这个文件。改完跑 res://scripts/LevelValidator.gd 看关卡是否还能过。
## ============================================================

# ------------------------------------------------------------
# 颜色
# ------------------------------------------------------------
## Rationale: 选 青(Cyan) / 橙(Orange)，不选行业惯例的红 / 绿。
##   - 红绿色盲是最常见色觉障碍（约 8% 男性），红绿跑道对这部分玩家直接不可玩。
##   - 青/橙 感知明度差约 1.9:1，低画质 / 投影 / 色弱下仍能区分。
##   - 两色在色轮上接近互补，切换时的视觉冲击最强。
const COLOR_A := Color(0.0, 0.898, 1.0)   # 青
const COLOR_B := Color(1.0, 0.478, 0.0)   # 橙

enum LaneColor { A, B }

func lane_color_value(c: int) -> Color:
	return COLOR_A if c == LaneColor.A else COLOR_B

# ------------------------------------------------------------
# 能量经济（核心）
# ------------------------------------------------------------
const ENERGY_MAX := 100.0
const ENERGY_START := 100.0

## 同色恢复 +8/s
## Rationale: 攒满 100 需 12.5 秒 = 12.5 × 12m/s = 150m 同色跑道。
##   这个 150m 是关卡"补给段"的长度锚——死亡段之前必须累计够 150m 同色，
##   否则玩家进死亡段时能量不够冲刺，关卡直接不可通关。
##   同时也是跳跃成本的锚：跳跃成本 = 1 秒同色收益，便于玩家心算。
const ENERGY_GAIN_SAME := 8.0

## 异色消耗 -18/s
## Rationale: 与恢复速率比 2.25 : 1。这个比值决定"贪"的代价是否可读：
##   - 1.0 : 1  → 异色上可以无限苟，风险决策彻底消失（致命）
##   - 1.5 : 1  → 惩罚过轻，玩家无脑抄近路，同色/异色失去区分度
##   - 2.25: 1  → 异色待 1 秒需同色待 2.25 秒补回，代价清晰可心算
##   - 3.0 : 1+ → 一碰异色就崩，玩家不敢做任何风险决策，退化成纯躲避
## [PLACEHOLDER] 验证路径: playtest 记录"玩家主动进入异色"的时间占比，
##   目标区间 20%–35%。低于 15% = 惩罚过重；高于 50% = 收益过高。
const ENERGY_DRAIN_DIFF := 18.0

## 冲刺消耗 -24/s，冲刺速度 24 m/s
## Rationale（全套数值里最关键的一条）:
##   冲刺的价值必须用"单位距离消耗"衡量，不能用"每秒消耗"：
##     硬闯异色: 18 / 12 = 1.50 点/米
##     跳跃蹭过: 约 1.33 点/米（见 JUMP_ENERGY_COST）
##     冲刺    : 24 / 24 = 1.00 点/米   → 最省
##   早期版本设 20m/s + 25点/s = 1.25 点/米，只省 17%，玩家没理由开冲刺，
##   技能沦为"看着爽但没用"。提到 24/24 后冲刺才真正划算，且三档被拉开。
##   副产物：满能量冲刺距离 = 100 / 1.0 = 100m 整 —— 关卡死亡段的长度锚。
const ENERGY_DRAIN_DASH := 24.0

# ------------------------------------------------------------
# 切色：无冷却，但清空能量
# ------------------------------------------------------------
## Rationale（用户拍板，且它确实比冷却更好）:
##   冷却限制的是"能不能切" → 操作门槛。
##   清空能量限制的是"值不值得切" → 资源决策，且天然制造沉没成本陷阱：
##   你攒得越久越舍不得切，越倾向硬闯异色，然后死在里面。这是我要的张力。
##
## 由此长出的核心策略表（进入异色段时能量 E，段长 L）：
##     L < E/1.5        → 硬闯最省（保住冲刺储备，留给长段）
##     E/1.5 ≤ L < 100  → 冲刺（硬闯会死）
##     L ≥ 100m         → 冲刺也耗尽，只能切色
##   emergent 技巧：在能量低的时候切色，沉没成本最小。
const SWITCH_CLEARS_ENERGY := true

# ------------------------------------------------------------
# 速度
# ------------------------------------------------------------
## [PLACEHOLDER] 12 m/s（约 43 km/h）
## Rationale: 3D 第三人称下 <10 m/s 没有速度感，>15 m/s 跑道颜色来不及读。
## 验证路径: 改这个数必须同步复查"一次跳跃的前进距离" = SPEED_BASE × JUMP_AIR_TIME。
const SPEED_BASE := 12.0

## 冲刺速度 24 m/s（正好 2 倍基础速度）
## Rationale: 2 倍是"爽但不失控"的经验值；同时让单位距离消耗凑成整数 1.0，
##   方便关卡设计师心算预算（100m 冲刺 = 100 点能量）。
const SPEED_DASH := 24.0

# ------------------------------------------------------------
# 跳跃 / 多层跑道
# ------------------------------------------------------------
## 跳跃消耗 8 点能量（按【次】计费，与跨越几层无关）
## Rationale: 8 点 = 1 秒的同色收益（ENERGY_GAIN_SAME）。让"跳一次"和
##   "在同色上多跑一秒"在账面上等价，玩家不用查表就能权衡。
##   净收益核算（滞空 0.5s）:
##     在异色上跳: 花 8 点，免除 18 × 0.5 = 9 点消耗 → 净赚 1 点（勉强划算）
##     在同色上跳: 花 8 点，损失 8 × 0.5 = 4 点收益 → 净亏 12 点（明确惩罚）
##   → 异色该跳、同色别跳，两个方向相反且都明确，这是好机制的特征。
##
## 【2026-10-10 改：从"按层计费"改为"按次计费"】
##   关卡改成大幅留空后，一次跳跃经常跨越 2 层（中间那层没跑道）。
##   旧规则按跨越层数 ×8 收费，等于【惩罚关卡的稀疏度】:
##     只有一条跑道时，玩家往上跳 2 层和跳 1 层是同一个决定
##     —— 都是"离开脚下这条道"，凭什么收双倍？
##   成本应该给【玩家的决策】定价，不该给【关卡的几何】定价。
##   现在：一次跳跃 = 一个动作 = 8 点。跨几层是关卡的事，不是玩家的事。
const JUMP_ENERGY_COST := 8.0

## 滞空 0.58s → 一次跳跃前进 12 × 0.58 = 6.96m
## Rationale: 6.96m 决定"碎色区"的最小段长。段长 < 6.96m 的颜色交替可以被一次
##   跳跃整体跨过 → 跳跃成为碎色区的解法，而不是死局。
## 横版下另有含义: 相邻层间距 3.2m / 滞空 0.58s，横版里这段位移是可见的
##   抛物线，玩家能明确读出"我正在往第 2 层跳"。
## [PLACEHOLDER] 验证路径: 手感 + 关卡节奏。<0.35s 没有滞空感，>0.7s 角色发飘。
##
## 【2026-10-10 用户要求：延长跳跃时间】0.5 → 0.58。
##   为什么只加 0.08 而不是更多 —— 这不是随手定的，是【三档成本】卡住的上限：
##     一次跳跃前进 = SPEED_BASE × 本值，每跳固定 8 点，
##     所以"跳着过异色"的单价 = 8 / (12 × 本值) 点/米（实测还要再高约 4%，
##     因为每跳落地至少踩地一帧）。
##       本值 0.50 → 1.33 点/米
##       本值 0.58 → 1.15 点/米
##       本值 0.70 → 0.95 点/米  ← 跌破冲刺的 1.0，"冲刺最便宜"这条设计作废
##   0.67 是数学临界点。0.58 留了约 15% 余量，是"手感能变长、成本序不破"的最大公约数。
##   ⚠ 再想加长，必须同步抬高 JUMP_ENERGY_COST，不能只动这个数。
const JUMP_AIR_TIME := 0.58

## 落地后多久才能再跳。0 = 落地当帧即可再跳。
## Rationale(原始设计): 三档成本被刻意拉开 ——
##   硬闯异色 1.5 点/米 ＞ 【跳着过】8 / 6.96m = 1.15 点/米 ＞ 冲刺 1.0 点/米。
##   跳跃是夹在中间的第三档解法，这个数就是它成立的前提。
##   （滞空 0.5 → 0.58 之后，这一档从 1.33 压到 1.15，余量变薄但序列没破。
##     见 JUMP_AIR_TIME 的推导：0.67s 是临界点。）
## Rationale(2026-10-10 归零): 用户要求"玩家在任何时刻都可以跳跃"。
##   留 0.25s 冷却时，跳着过异色段的真实成本是 1.39 点/米
##   （多出落地那 0.25s 的地面损耗），与上面写的 1.33 对不上；
##   而且"落地后 0.25s 内按键没反应"本身就是玩家读得到的输入延迟。
##   归零之后这个数才真正等于 1.33。
## 注意：按住不放不会连跳 —— Main 已过滤 event.echo，必须一下一下点。
##   所以"高频连跳"是操作量换成本的技巧，不是按住就能过的作弊。
## 保留常量而不是删掉 jump_cd 逻辑：它是手感旋钮，很可能还要回调。
const JUMP_COOLDOWN := 0.0

## 【已删除 2026-10-10】向上跳的额外弧线高度（旧值 1.6）。
##   它是"两套公式"时代的产物：上跳走 y = lerp(层A,层B,t) + sin(πt)·本值，
##   原地跳另走一条 y = 层高 + sin(πt)·INPLACE_JUMP_ARC。
##   用户要求把两者整合，现在全走 JUMP_APEX_Y 那条抛物线（见下方），
##   本常量不再需要。留着这行注释是为了让后来者知道它【去哪了】，不是忘了删。

## 【2026-10-10 新规则】原地跳 —— 该方向没有实体跑道时，按键不再被静默吞掉，
## 而是原地弹一下（不换层、不前进），并按【脚下的颜色】定价：
##   同色轨道 → 免费。此时冻结结算对玩家是纯损失（放弃了 +8/s 的回血），
##             再收 8 点等于双重惩罚，而且会逼得玩家不敢按。
##   异色轨道 → 照收 JUMP_ENERGY_COST。它确实替玩家挡掉了
##             18/s × 0.5s = 9 点伤害，免费就等于开了一条零成本穿越异色段的路。
## 为什么必须有这条规则：大幅留空之后"该方向没有跑道"成了高频事件，
##   旧规则（静默 return）会让按键看起来彻底失灵 —— 那正是本轮报上来的 bug。
## ⚠ 已知后果：异色段上连续原地跳 ≈ 1.33 点/米，可以"跳过一个冲刺门"。
##   这不是漏洞，是上面 JUMP_COOLDOWN 注释里写着的那第三档解法；
##   代价是必须按 2 次/秒精确落地即按，而且冲刺（1.0）依然明显更优。
const INPLACE_JUMP_FREE_ON_SAME := true

## 横版重构（2026-10-09）：从「2 层 × 3 轨」改为「3 层 × 1 轨」。
## Rationale: 侧视相机下横向三轨没有视觉表达——三条道要么互相遮挡、要么
##   根本看不出自己在第几条，而"我在哪条道上"是每秒都要读的信息。
##   上下三层在横版里是天然的、零歧义的表达（Chameleon Run 原作即是如此）。
##   代价: 每段的颜色组合从 6 格降到 3 格，关卡设计空间收窄 —— 但可读性
##   是这个游戏的生死线，用设计空间换可读性是对的交换。
const LAYER_COUNT := 3
## 层间距 3.2m
## Rationale: 横版侧视下三层沿屏幕纵向排列，间距决定"三层能否一眼分清"。
##   下界: 角色高 1.4m + 跳跃弧高 1.6m，间距 <2.6m 时跳跃中角色会与相邻层
##         视觉重叠，读不出"我在往哪层跳"。
##   上界: 三层总高 6.4m，加上相机需容纳的余量，>4m 会让画面垂直占用过大，
##         挤压水平可见距离（横版最稀缺的资源是水平视野）。
## [PLACEHOLDER] 验证路径: 截图。判据 = 能否一眼数出"我现在在第几层"。
## 层高与层间距各自只定义一次：LAYER_Y 和相机锚点都从 LAYER_SPACING 推导，
##   避免"改了间距忘了改相机/忘了改原地跳弧高"这类散落式错误。
const LAYER_SPACING := 3.2
const LAYER_Y := [0.0, LAYER_SPACING, LAYER_SPACING * 2.0]

## 【2026-10-10 用户要求】把「跳跃」和「跳到上一层」整合成【同一条曲线】，
## 顶点取【固定的绝对高度】，滞空同时延长（见 JUMP_AIR_TIME）。
##
## 旧实现是两套公式、两个常量：
##     上跳 / 下跳   y = lerp(层A, 层B, t) + sin(πt) · JUMP_ARC_HEIGHT
##     原地跳        y = 层高 + sin(πt) · INPLACE_JUMP_ARC   ← 另一条曲线、另一个常量
##   上一轮为了让两者"一样高"，是靠【调参把它们凑到一起】—— INPLACE_JUMP_ARC
##   那个 3.53678 就是这么反解出来的。那是个补丁，不是设计。
##   现在顶点由常量固定，两种跳跃用同一条公式，**"一样高"变成结构性的结果**，
##   不再是凑出来的：你落回哪一层只决定曲线怎么接到顶点、再怎么落下来。
##
## 曲线：抛物线 y(t) = 层A + b·t + a·t²
##   过 (0, 层A) 与 (1, 层B)，且峰值【恰好】= JUMP_APEX_Y。解：
##     设 m = JUMP_APEX_Y − 层A（这一跳要爬多高）、d = 层B − 层A（净位移）
##        u = √m + √(m − d)
##        b = 2u√m ,  a = d − b ,  峰值时刻 t_p = b / (2(b − d))
##   原地跳 d = 0 → t_p 自动落在 0.5（对称的原地弹跳）
##   跳一层 d = 3.2 → t_p ≈ 0.568（爬得多、落得少，所以峰值偏后）
##   跳两层 d = 6.4 → t_p ≈ 0.716（几乎全程都在爬，最后才落下来）
##   同一条公式给出三种形状 —— 这就是"整合"。实现见 Player._solve_jump_arc。
##
## ⚠ 顶点取【绝对高度】而不是"落点 + 余量"，是用户明确选的方案，代价也认了：
##   ① 从第 1 层起跳会冲到顶层之上再落回中层 —— 跳一层与跳两层【视觉一样】。
##   ② 层越低，这一跳越夸张（从底层起跳要爬 7.6m，约 5 个角色高）。
##   ③ 从顶层起跳只剩 1.2m 的弹跳。这是"最统一"的代价，也是下面下界判据的来源。
##
## 余量 1.2 的判据（**两个上界都是实测出来的，不是估的**）：
##   下界：顶层原地跳必须肉眼可见 —— 角色高 1.4m，抬起 1.2m 才确定它离了地；
##         再矮就变成"抖了一下"，违反"按键永远有反馈"。
##   上界：720p 实测约 36 px/m，角色中心顶点 = 7.6 + 0.95 ≈ 8.55（屏幕 y≈133），
##         角色顶 ≈ 9.63；HUD 底边 ≈ 9.70。**只剩 0.07m（约 3px）的余量** ——
##         顶点再高 0.1m，跳跃最高点就会贴上 HUD 文字。
##         （HUD 文字在屏幕左侧 x<340，角色在 x≈360，所以目前只是"贴着"没重叠。）
##   ⚠ 所以 1.2 基本就是天花板。想再抬高顶点，必须先把相机纵向锚点或 HUD 布局改掉，
##     不能只改这个数。
const JUMP_APEX_CLEARANCE := 1.2
const JUMP_APEX_Y := LAYER_Y[LAYER_COUNT - 1] + JUMP_APEX_CLEARANCE

## ⚠ 顶点固定带来的第一个副作用：从底层向中层跳时，曲线会在【上升段】穿过中层跑道。
##   【已核查，结论：可接受，不需要修】
##   算过穿透窗口：跳一层时脚底穿过中层板厚(0.5m)只在 t ∈ [0.112, 0.136]，
##   换算成水平位移 = 0.024 × 6.96 ≈ 0.17m，即 12m/s 下约 1 帧。
##   跳两层时根本不会发生 —— 落点在中层之上，下降段永远回不到中层高度。
##   跑道是薄板、1 帧的接触在 60fps 下读不出来，判定上也不存在"卡住"的可能
##   （本游戏的跳跃不参与碰撞，落点由 next_track_layer 一次算定）。
##   若将来有人把 TRACK_THICKNESS 加厚，这条结论要重算。
## ⚠ 顶点固定带来的第二个副作用：一次跳跃的弧线【不再透露落点】。
##   旧实现"跳一层"和"跳两层"弧高不同（span 越大弧越高），玩家能从弧线预判
##   自己要去哪层；现在两者视觉一样 —— 这正是用户选的"最统一"的代价。
##   于是"我这次会落在第几层"改由【关卡本身】回答，靠两处补：
##     ① 脚下的颜色光环：向上跳时留在出发层（读作"我离开的那块地"），
##        向下运动时贴到落点层。见 Player._update_transform。
##     ② HUD 的"第 N / 3 层" + 缺口预警（跳跃窗口打开时它会直接说
##        "现在！按 W 上跳到第 2 层"）。
##   若 playtest 出现"以为跳上去了，其实是原地跳"，优先强化光环和 HUD，
##   不要去动 JUMP_APEX_Y —— 顶点高度是用户点名要的。

# ------------------------------------------------------------
# 死亡判定
# ------------------------------------------------------------
## 硬核：能量归零即死，无宽限（用户拍板）
## 但空中不判定（见 Player.gd），所以切色归零后仍有救济路径：
##   立刻跳 → 空中豁免 → 落在正确颜色上 → 回血 → 活。
## 这让"跳跃"从换层工具升级为救命工具，是本套机制能自洽的关键。
##
## [TUNING LEVER] 若 playtest 显示"手滑误切致死"占比 > 30%，
##   把这个值调到 0.4：能量归零后给 0.4 秒濒死窗口（红闪 + 警报音），
##   期间踩回同色可获救。不要用削弱其它数值的方式补偿新手，改这个。
const DEATH_GRACE_SEC := 0.0

# ------------------------------------------------------------
# 跑道几何
# ------------------------------------------------------------
## 横版下单道：横向换道被移除，"换道"这个动作维度由"上下切层"承接。
## 跑道加宽到 4.5m —— 侧视下跑道是一条横贯屏幕的带子，窄了读不出颜色面积。
const LANE_COUNT := 1
const LANE_WIDTH := 4.5
const LANE_X := [0.0]
