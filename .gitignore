# ---------------------------------------------------------------
# Godot 4 官方推荐忽略项
# ---------------------------------------------------------------
# 编辑器导入/缓存目录（由 Godot 自动重建，不应入库）
.godot/
# 旧版导入缓存
.import/

# 导出配置与产物
export.cfg
export_presets.cfg
build/
*.exe
*.pck
*.zip

# 自动生成的翻译资源（由 CSV 生成）
*.translation

# Mono/C# 相关（本工程为 GDScript，留作保险）
.mono/
data_*/
mono_crash.*.json

# ---------------------------------------------------------------
# 本工程自定义忽略项
# ---------------------------------------------------------------
# 调试截图：res://shots/ 带 .gdignore，属于本地视觉验证产物，不入库
shots/

# 操作系统 / 编辑器杂项
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
